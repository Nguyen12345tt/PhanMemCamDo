@using PhanMemCamDo.Models.Enums
@model PhanMemCamDo.Models.Entities.PaymentHistory

@{
    ViewData["Title"] = "Thu Tiền Khách Hàng";
    var contract = ViewBag.SelectedContract as PhanMemCamDo.Models.Entities.PawnContract;
    var currentEndDate = contract?.EndDate.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white py-3 text-center">
                    <h4 class="fw-bold mb-0">
                        <i class="fa-solid fa-hand-holding-dollar me-2"></i> THU TIỀN KHÁCH HÀNG
                    </h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="paymentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="CurrentEndDateVal" value="@currentEndDate" />
                        <input type="hidden" id="CurrentPawnAmount" value="@(contract?.PawnAmount ?? 0)" />
                        <input type="hidden" id="CurrentSuggestedInterest" value="@(ViewBag.SuggestedAmount ?? 0)" />

                        <!-- Ô chọn Hợp Đồng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                <i class="fa-solid fa-file-contract text-primary me-1"></i> Chọn Hợp Đồng <span class="text-danger">*</span>
                            </label>
                            @if (contract != null)
                            {
                                <input type="hidden" asp-for="PawnContractId" value="@contract.Id" />
                                <div class="form-control fw-bold bg-light text-primary fs-5">
                                    @contract.ContractCode - @contract.Customer?.FullName
                                </div>
                            }
                            else
                            {
                                <select asp-for="PawnContractId" id="SelectContract" class="form-select form-select-lg fw-bold border-primary" asp-items="ViewBag.PawnContractId" onchange="fetchContractInfo(this.value)">
                                    <option value="">-- Chọn hợp đồng cầm đồ --</option>
                                </select>
                            }
                        </div>

                        <!-- Khung thông tin hợp đồng được chọn (Live Preview Card) -->
                        <div id="ContractPreviewCard" class="card border-0 bg-light p-3 rounded-3 mb-3 shadow-sm" style="@(contract != null ? "" : "display:none;")">
                            <div class="row align-items-center">
                                <div class="col-md-6 border-end">
                                    <div class="small text-muted mb-1"><i class="fa-solid fa-user me-1"></i> Khách hàng:</div>
                                    <h6 class="fw-bold text-dark mb-2" id="previewCustomer">@(contract?.Customer?.FullName ?? "---")</h6>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1 text-success"></i> SĐT: <span id="previewPhone" class="fw-bold">@(contract?.Customer?.PhoneNumber ?? "---")</span></div>
                                    <div class="small text-muted"><i class="fa-solid fa-box me-1 text-warning"></i> Tài sản: <span id="previewAsset" class="fw-bold">@(contract?.Asset?.AssetName ?? "---")</span></div>
                                </div>
                                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                                    <div class="small text-muted mb-1">Dư nợ gốc hiện tại:</div>
                                    <div class="fw-bold text-danger fs-4" id="previewPawnAmount">@string.Format("{0:N0}", contract?.PawnAmount ?? 0) VNĐ</div>
                                    <div class="small text-muted">Lãi suất: <span id="previewInterestRate" class="fw-bold text-primary">@(contract?.InterestRate ?? 0)%</span> / tháng</div>
                                </div>
                            </div>
                        </div>

                        <!-- Loại Giao Dịch -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">
                                <i class="fa-solid fa-list-check text-success me-1"></i> Loại Giao Dịch
                            </label>
                            <select asp-for="PaymentType" class="form-select form-select-lg fw-bold" asp-items="Html.GetEnumSelectList<PaymentType>()" id="PaymentTypeSelect" onchange="onPaymentTypeChange()">
                            </select>
                        </div>

                        <!-- Khung tính toán Trả Bớt Gốc (Dynamic Principal Box) -->
                        <div id="PrincipalDeductionBox" class="alert alert-warning border-warning border-2 rounded-3 shadow-sm mb-3" style="display:none;">
                            <div class="fw-bold text-dark mb-2">
                                <i class="fa-solid fa-calculator me-1 text-danger"></i> Chi Tiết Khấu Trừ Tiền Gốc:
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted">Tiền gốc hiện tại:</span>
                                <span class="fw-bold text-dark fs-6" id="calcOldPrincipal">0 đ</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted">Số tiền khách trả bớt gốc:</span>
                                <span class="fw-bold text-danger fs-6" id="calcPayAmount">- 0 đ</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success"><i class="fa-solid fa-arrow-right-long me-1"></i> Dư nợ gốc còn lại:</span>
                                <span class="fw-bold text-success fs-5" id="calcRemainingPrincipal">0 đ</span>
                            </div>
                            <div id="principalWarning" class="small text-danger fw-bold mt-2" style="display:none;">
                                ⚠️ Số tiền trả bớt không được vượt quá số tiền nợ gốc hiện tại!
                            </div>
                        </div>

                        <!-- Khung thông báo Chuộc Đồ -->
                        <div id="RedeemNoticeBox" class="alert alert-success border-success rounded-3 shadow-sm mb-3" style="display:none;">
                            <i class="fa-solid fa-circle-check me-2"></i>
                            <strong>Tất Toán / Chuộc Đồ:</strong> Thu toàn bộ tiền gốc <strong id="redeemAmountText">0 đ</strong> để thanh lý và trả lại tài sản cho khách hàng. Hợp đồng sẽ chuyển sang trạng thái <strong>Đã Chuộc</strong>.
                        </div>

                        <!-- Khung thông báo Thanh Lý Tài Sản -->
                        <div id="LiquidationNoticeBox" class="alert alert-danger border-danger rounded-3 shadow-sm mb-3" style="display:none;">
                            <i class="fa-solid fa-gavel me-2"></i>
                            <strong>Thanh Lý Tài Sản:</strong> Ghi nhận tiền thu từ thanh lý tài sản để thu hồi vốn. Hợp đồng sẽ tự động chuyển sang trạng thái <strong>Đã Thanh Lý</strong>.
                        </div>

                        <!-- Số Tiền Thu -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-success">
                                <i class="fa-solid fa-money-bill-wave me-1"></i> Số Tiền Thu (VNĐ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-success fw-bold">₫</span>
                                <input asp-for="Amount" type="number" min="1" step="any" id="InputAmount" class="form-control fw-bold text-success" placeholder="Nhập số tiền..." required oninput="calculatePrincipalDeduction()" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Khung Gia Hạn (Khi Đóng Lãi) -->
                        <div class="card bg-light border-0 mb-3" id="ExtensionSection" style="display:none;">
                            <div class="card-body p-3">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="IsExtendCheckbox">
                                    <label class="form-check-label fw-bold text-primary" for="IsExtendCheckbox">
                                        <i class="fa-solid fa-calendar-plus me-1"></i> Có gia hạn thêm thời hạn hợp đồng không?
                                    </label>
                                </div>

                                <div id="AutoExtendArea" style="display:none;">
                                    <div class="input-group mb-2">
                                        <span class="input-group-text bg-white"><i class="fa-solid fa-clock text-primary"></i></span>
                                        <input type="number" name="AutoExtendDays" id="AutoExtendDays" class="form-control fw-bold" value="30" placeholder="Số ngày..." />
                                        <span class="input-group-text">ngày</span>
                                    </div>

                                    <div class="d-flex justify-content-between small border-top pt-2 mt-2">
                                        <div class="text-muted">
                                            Hạn cũ:<br>
                                            <span class="fw-bold" id="oldEndDateText">@contract?.EndDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                        <div class="text-end">
                                            <i class="fa-solid fa-arrow-right text-primary"></i> Hạn MỚI:<br>
                                            <span class="fw-bold text-primary fs-6" id="NewEndDateDisplay">...</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-pen me-1"></i> Ghi Chú</label>
                            <textarea asp-for="Note" class="form-control" rows="2" placeholder="Ví dụ: Đóng lãi tháng 1, Trả bớt 2 triệu gốc..."></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm py-3 fw-bold">
                                <i class="fa-solid fa-check-circle me-2"></i> XÁC NHẬN THU TIỀN
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2">Hủy Bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function formatVNMoney(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
        }

        function fetchContractInfo(contractId) {
            if (!contractId) {
                document.getElementById('ContractPreviewCard').style.display = 'none';
                document.getElementById('CurrentPawnAmount').value = 0;
                document.getElementById('CurrentSuggestedInterest').value = 0;
                onPaymentTypeChange();
                return;
            }

            fetch('/PaymentHistories/GetContractDetail/' + contractId)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('previewCustomer').innerText = data.customerName;
                    document.getElementById('previewPhone').innerText = data.phone;
                    document.getElementById('previewAsset').innerText = data.assetName;
                    document.getElementById('previewPawnAmount').innerText = formatVNMoney(data.pawnAmount);
                    document.getElementById('previewInterestRate').innerText = data.interestRate + '%';
                    
                    document.getElementById('CurrentPawnAmount').value = data.pawnAmount;
                    document.getElementById('CurrentSuggestedInterest').value = data.suggestedInterest;
                    document.getElementById('CurrentEndDateVal').value = data.endDateIso;
                    document.getElementById('oldEndDateText').innerText = data.endDate;

                    document.getElementById('ContractPreviewCard').style.display = 'block';

                    onPaymentTypeChange();
                })
                .catch(err => console.error('Lỗi tải thông tin hợp đồng:', err));
        }

        function onPaymentTypeChange() {
            var type = document.getElementById('PaymentTypeSelect').value;
            var currentPawnAmount = parseFloat(document.getElementById('CurrentPawnAmount').value) || 0;
            var suggestedInterest = parseFloat(document.getElementById('CurrentSuggestedInterest').value) || 0;

            var principalBox = document.getElementById('PrincipalDeductionBox');
            var extensionSection = document.getElementById('ExtensionSection');
            var redeemNoticeBox = document.getElementById('RedeemNoticeBox');
            var liquidationNoticeBox = document.getElementById('LiquidationNoticeBox');
            var inputAmount = document.getElementById('InputAmount');

            // 1: Interest (Đóng Lãi), 2: Principal (Trả Bớt Gốc), 3: Redeem (Chuộc Đồ), 4: Liquidation (Thanh Lý)
            if (type == "1") { // Đóng Lãi
                principalBox.style.display = 'none';
                redeemNoticeBox.style.display = 'none';
                liquidationNoticeBox.style.display = 'none';
                extensionSection.style.display = 'block';
                if (suggestedInterest > 0) {
                    inputAmount.value = suggestedInterest;
                }
            } 
            else if (type == "2") { // Trả Bớt Gốc
                principalBox.style.display = 'block';
                extensionSection.style.display = 'none';
                redeemNoticeBox.style.display = 'none';
                liquidationNoticeBox.style.display = 'none';
                inputAmount.value = ''; // Để người dùng tự gõ số tiền muốn trả bớt
                calculatePrincipalDeduction();
            } 
            else if (type == "3") { // Chuộc Đồ (Tất Toán)
                principalBox.style.display = 'none';
                extensionSection.style.display = 'none';
                liquidationNoticeBox.style.display = 'none';
                redeemNoticeBox.style.display = 'block';
                document.getElementById('redeemAmountText').innerText = formatVNMoney(currentPawnAmount);
                if (currentPawnAmount > 0) {
                    inputAmount.value = currentPawnAmount;
                }
            } 
            else if (type == "4") { // Thanh Lý Tài Sản
                principalBox.style.display = 'none';
                extensionSection.style.display = 'none';
                redeemNoticeBox.style.display = 'none';
                liquidationNoticeBox.style.display = 'block';
                if (currentPawnAmount > 0) {
                    inputAmount.value = currentPawnAmount;
                }
            }
            else {
                principalBox.style.display = 'none';
                extensionSection.style.display = 'none';
                redeemNoticeBox.style.display = 'none';
                liquidationNoticeBox.style.display = 'none';
            }
        }

        function calculatePrincipalDeduction() {
            var type = document.getElementById('PaymentTypeSelect').value;
            if (type != "2") return; // Chỉ tính khi chọn Trả bớt gốc

            var currentPawnAmount = parseFloat(document.getElementById('CurrentPawnAmount').value) || 0;
            var payAmount = parseFloat(document.getElementById('InputAmount').value) || 0;

            var remaining = currentPawnAmount - payAmount;
            if (remaining < 0) remaining = 0;

            document.getElementById('calcOldPrincipal').innerText = formatVNMoney(currentPawnAmount);
            document.getElementById('calcPayAmount').innerText = '- ' + formatVNMoney(payAmount);
            document.getElementById('calcRemainingPrincipal').innerText = formatVNMoney(remaining);

            var warning = document.getElementById('principalWarning');
            if (payAmount > currentPawnAmount && currentPawnAmount > 0) {
                warning.style.display = 'block';
            } else {
                warning.style.display = 'none';
            }
        }

        $(document).ready(function() {
            // Chống gửi Form 2 lần (Double Click Protection)
            $('#paymentForm').on('submit', function() {
                var btn = $(this).find('button[type="submit"]');
                if (btn.data('submitting') === true) {
                    return false;
                }
                btn.data('submitting', true);
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Đang xử lý thu tiền...');
            });

            $("#IsExtendCheckbox").change(function() {
                if ($(this).is(":checked")) {
                    $("#AutoExtendArea").slideDown();
                    calculateNewDate();
                } else {
                    $("#AutoExtendArea").slideUp();
                    $("#AutoExtendDays").val(0);
                }
            });

            $("#AutoExtendDays").on("input", calculateNewDate);

            function calculateNewDate() {
                var days = parseInt($("#AutoExtendDays").val()) || 0;
                var currentStr = $("#CurrentEndDateVal").val();
                if (currentStr && days > 0) {
                    var date = new Date(currentStr);
                    date.setDate(date.getDate() + days);
                    var day = ("0" + date.getDate()).slice(-2);
                    var month = ("0" + (date.getMonth() + 1)).slice(-2);
                    var year = date.getFullYear();
                    $("#NewEndDateDisplay").text(day + "/" + month + "/" + year);
                } else {
                    $("#NewEndDateDisplay").text("Không đổi");
                }
            }

            // Chạy lần đầu tiên khi tải trang
            onPaymentTypeChange();
        });
    </script>
}