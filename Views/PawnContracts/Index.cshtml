@using PhanMemCamDo.Models.Enums
@model IEnumerable<PhanMemCamDo.Models.Entities.PawnContract>

@{
    ViewData["Title"] = "Danh Sách Hợp Đồng";
    var currentFilter = ViewBag.CurrentStatusFilter as string ?? "";
}

<div class="container-fluid mt-4">

    <!-- Summary Cards -->
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 small opacity-75">💰 Vốn Đang Cho Vay</h6>
                            <h4 class="fw-bold mb-0">@String.Format("{0:N0}", ViewBag.VonDangVay) đ</h4>
                        </div>
                        <i class="fa-solid fa-sack-dollar fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 small opacity-75">📄 Đang Hoạt Động</h6>
                            <h4 class="fw-bold mb-0">@ViewBag.DangChay <small class="fs-6 fw-normal">hồ sơ</small></h4>
                        </div>
                        <i class="fa-solid fa-file-contract fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 small opacity-75">🚨 Cầm Quá Hạn (Chờ TL)</h6>
                            <h4 class="fw-bold mb-0">@ViewBag.QuaHan <small class="fs-6 fw-normal">hồ sơ</small></h4>
                        </div>
                        <i class="fa-solid fa-triangle-exclamation fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-dark shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase mb-1 small opacity-75">🔨 Đã Thanh Lý</h6>
                            <h4 class="fw-bold mb-0 text-warning">@ViewBag.DaThanhLy <small class="fs-6 fw-normal text-white opacity-75">hồ sơ</small></h4>
                        </div>
                        <i class="fa-solid fa-gavel fa-2x opacity-50 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="text-primary fw-bold mb-0"><i class="fa-solid fa-list"></i> Quản Lý Hợp Đồng</h4>

        <div class="d-flex gap-2">
            <form asp-action="Index" method="get" class="d-flex">
                <input type="hidden" name="statusFilter" value="@currentFilter" />
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Tìm tên khách, mã HĐ..." value="@Context.Request.Query["searchString"]">
                    <button class="btn btn-outline-primary" type="submit"><i class="fa-solid fa-search"></i></button>
                </div>
            </form>

            <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
                <i class="fa-solid fa-plus"></i> Tạo Mới
            </a>
        </div>
    </div>

    <!-- Filter Nav Pills -->
    <ul class="nav nav-pills mb-3 gap-1">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(currentFilter) ? "active fw-bold" : "bg-white text-dark border")"
               asp-action="Index" asp-route-statusFilter="">Tất Cả</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "active" ? "active fw-bold" : "bg-white text-dark border")"
               asp-action="Index" asp-route-statusFilter="active">Đang Hoạt Động</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "overdue" ? "active bg-danger fw-bold" : "bg-white text-danger border")"
               asp-action="Index" asp-route-statusFilter="overdue">
                <i class="fa-solid fa-clock me-1"></i> Quá Hạn (@ViewBag.QuaHan)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "liquidated" ? "active bg-dark text-warning fw-bold" : "bg-white text-dark border")"
               asp-action="Index" asp-route-statusFilter="liquidated">
                <i class="fa-solid fa-gavel me-1"></i> Đã Thanh Lý (@ViewBag.DaThanhLy)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentFilter == "redeemed" ? "active bg-secondary fw-bold" : "bg-white text-secondary border")"
               asp-action="Index" asp-route-statusFilter="redeemed">Đã Chuộc</a>
        </li>
    </ul>

    <!-- Table -->
    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary text-uppercase small fw-bold">
                        <tr>
                            <th class="ps-3">Mã HĐ</th>
                            <th>Khách Hàng</th>
                            <th>Tài Sản</th>
                            <th class="text-end">Tiền Cầm</th>
                            <th>Ngày Cầm</th>
                            <th>Ngày Hết Hạn</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center">Tác Vụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isOver = item.Status == ContractStatus.Active && item.EndDate < DateTime.Now;
                            var isNear = item.Status == ContractStatus.Active && item.EndDate >= DateTime.Now && item.EndDate <= DateTime.Now.AddDays(3);

                            <tr class="@(isOver ? "bg-danger bg-opacity-10" : "")">
                                <td class="ps-3 fw-bold text-primary">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                        @item.ContractCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Customer?.FullName</div>
                                    <small class="text-muted">@item.Customer?.PhoneNumber</small>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Asset?.AssetName</div>
                                    <small class="text-muted">@(item.Asset?.AssetCategory?.Name ?? "Chưa phân loại")</small>
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    @String.Format("{0:N0}", item.PawnAmount) đ
                                </td>
                                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>

                                <td class="@(isOver ? "text-danger fw-bold" : (isNear ? "text-warning fw-bold" : ""))">
                                    @item.EndDate.ToString("dd/MM/yyyy")
                                    @if (isOver)
                                    {
                                        <br /><small class="badge bg-danger">Trễ @((DateTime.Now - item.EndDate).Days) ngày</small>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.Status == ContractStatus.Liquidated)
                                    {
                                        <span class="badge bg-dark text-warning"><i class="fa-solid fa-gavel me-1"></i> Đã Thanh Lý</span>
                                    }
                                    else if (item.Status == ContractStatus.Redeemed)
                                    {
                                        <span class="badge bg-secondary">Đã Chuộc</span>
                                    }
                                    else if (isOver)
                                    {
                                        <span class="badge bg-danger">Quá Hạn Cầm</span>
                                    }
                                    else if (item.Status == ContractStatus.Active)
                                    {
                                        <span class="badge bg-success bg-opacity-75">Đang Hoạt Động</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-info" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        @if (item.Status != ContractStatus.Liquidated && item.Status != ContractStatus.Redeemed)
                                        {
                                            <a asp-action="Liquidate" asp-route-id="@item.Id" class="btn btn-sm btn-danger fw-bold" title="Thanh lý tài sản">
                                                <i class="fa-solid fa-gavel"></i> Thanh Lý
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary" title="Sửa">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                        }

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-folder-open fa-2x mb-2 opacity-50"></i>
                    <p class="mb-0">Không tìm thấy hợp đồng nào khớp điều kiện.</p>
                </div>
            }
        </div>
    </div>
</div>