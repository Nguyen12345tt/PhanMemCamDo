@using PhanMemCamDo.Models.Enums
@model PhanMemCamDo.Models.Entities.PawnContract

@{
    ViewData["Title"] = "Chi Tiết Hợp Đồng";
}

<div class="container mt-4 mb-5" style="max-width: 900px;">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-bold">📄 Chi Tiết Hợp Đồng: <span class="text-warning">@Model.ContractCode</span></h4>
            @if (Model.Status == ContractStatus.Liquidated)
            {
                <span class="badge bg-danger text-white fs-6 px-3 py-2"><i class="fa-solid fa-gavel me-1"></i> Đã Thanh Lý</span>
            }
            else if (Model.Status == ContractStatus.Redeemed)
            {
                <span class="badge bg-secondary fs-6 px-3 py-2">Đã Chuộc</span>
            }
            else if (Model.EndDate < DateTime.Now)
            {
                <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="fa-solid fa-clock me-1"></i> Quá Hạn Cầm</span>
            }
            else
            {
                <span class="badge bg-success fs-6 px-3 py-2">Đang Hoạt Động</span>
            }
        </div>
        <div class="card-body p-4">
            <dl class="row fs-5 mb-2">
                <dt class="col-sm-3 text-muted">Khách Hàng:</dt>
                <dd class="col-sm-9 fw-bold text-primary">@Model.Customer?.FullName</dd>

                <dt class="col-sm-3 text-muted">CCCD/CMND:</dt>
                <dd class="col-sm-9">@Model.Customer?.IdentityCard</dd>

                <dt class="col-sm-3 text-muted">Số Điện Thoại:</dt>
                <dd class="col-sm-9">@Model.Customer?.PhoneNumber</dd>
            </dl>
            <hr class="my-3">
            <dl class="row fs-5 mb-2">
                <dt class="col-sm-3 text-muted">Tài Sản Cầm:</dt>
                <dd class="col-sm-9 fw-bold text-dark">@Model.Asset?.AssetName</dd>

                <dt class="col-sm-3 text-muted">Loại Tài Sản:</dt>
                <dd class="col-sm-9">@(Model.Asset?.AssetCategory?.Name ?? "Chưa phân loại")</dd>

                <dt class="col-sm-3 text-muted">Mô Tả / Tình Trạng:</dt>
                <dd class="col-sm-9 text-muted fs-6">@(string.IsNullOrEmpty(Model.Asset?.Description) ? "Không có mô tả" : Model.Asset.Description)</dd>
            </dl>
            <hr class="my-3">
            <dl class="row fs-5 mb-2">
                <dt class="col-sm-3 text-muted">Số Tiền Cầm (Gốc):</dt>
                <dd class="col-sm-9 text-danger fw-bold display-6">@Model.PawnAmount.ToString("N0") đ</dd>

                <dt class="col-sm-3 text-muted">Lãi Suất:</dt>
                <dd class="col-sm-9">@Model.InterestRate % / tháng</dd>

                <dt class="col-sm-3 text-muted">Thời Gian Hợp Đồng:</dt>
                <dd class="col-sm-9">
                    Từ <b>@Model.StartDate.ToString("dd/MM/yyyy")</b>
                    đến <b class="@(Model.EndDate < DateTime.Now ? "text-danger" : "")">@Model.EndDate.ToString("dd/MM/yyyy")</b>
                </dd>
            </dl>

            <hr class="my-3 border-danger border-2 opacity-50">
            <dl class="row fs-5 mb-0">
                <dt class="col-sm-3 text-danger fw-bold align-self-center mt-2">Tổng Tính Đến Nay:</dt>
                <dd class="col-sm-9 text-danger fw-bold display-5 mb-0 mt-2">
                    @if (ViewBag.TongTienPhaiTra != null)
                    {
                        @(((decimal)ViewBag.TongTienPhaiTra).ToString("N0")) <text> đ</text>
                    }
                    else
                    {
                        <span class="fs-4 text-warning">Đang cập nhật...</span>
                    }
                    <div class="fs-6 text-muted fw-normal mt-1">
                        <i>(Bao gồm Gốc + Lãi dồn tích tính đến hôm nay: @DateTime.Now.ToString("dd/MM/yyyy"))</i>
                    </div>
                </dd>
            </dl>
        </div>
        <div class="card-footer text-end bg-light py-3 pe-4">
            <a asp-action="Index" class="btn btn-secondary me-2"><i class="fa-solid fa-arrow-left me-1"></i> Quay Lại</a>
            
            @if (Model.Status != ContractStatus.Liquidated && Model.Status != ContractStatus.Redeemed)
            {
                <a asp-action="Liquidate" asp-route-id="@Model.Id" class="btn btn-danger me-2 fw-bold shadow-sm">
                    <i class="fa-solid fa-gavel me-1"></i> Thanh Lý Tài Sản
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2 fw-bold"><i class="fa-solid fa-pen me-1"></i> Sửa Hợp Đồng</a>
            }
        </div>
    </div>
</div>