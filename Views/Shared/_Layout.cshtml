@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phần Mềm Cầm Đồ</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhanMemCamDo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @{
                    var currentStoreName = Context.Session.GetString("StoreName") ?? "Cầm Đồ Xịn";
                }
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-shop"></i> @currentStoreName
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="Customers" asp-action="Index">Khách Hàng</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="Assets" asp-action="Index">Kho Tài Sản</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="PawnContracts" asp-action="Index">Hợp Đồng</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="PaymentHistories" asp-action="Index">Sổ Quỹ</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-primary fw-bold" asp-controller="Reports" asp-action="Index">
                                <i class="fa-solid fa-chart-pie"></i> Báo Cáo
                            </a>
                        </li>

                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-secondary fw-bold" asp-controller="SystemConfigs" asp-action="Index">
                                    <i class="fa-solid fa-gear"></i> Cấu Hình
                                </a>
                            </li>
                        }
                    </ul>

<ul class="navbar-nav ms-auto align-items-center">
    <!-- Nút Thông Báo (Bell Icon 🔔) - Hiển thị luôn trên Navbar -->
    <li class="nav-item dropdown me-3">
        <a class="nav-link position-relative text-dark fs-5 p-2" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" onclick="LoadNotifications()">
            <i class="fa-solid fa-bell text-warning"></i>
            <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none; font-size: 0.65rem;">
                0
            </span>
        </a>
        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-0" style="width: 340px; max-height: 450px; overflow-y: auto;" aria-labelledby="notifDropdown">
            <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-bell me-1 text-warning"></i> Thông Báo</h6>
                <button class="btn btn-link btn-sm text-primary p-0 text-decoration-none small" onclick="MarkAllRead(event)">Đã đọc tất cả</button>
            </div>
            <div id="notifList" class="list-group list-group-flush">
                <div class="text-center py-3 text-muted small"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải thông báo...</div>
            </div>
        </div>
    </li>

    @{
        // Lấy tên đăng nhập và vai trò từ Session
        var username = Context.Session.GetString("Username");
        var fullName = Context.Session.GetString("FullName") ?? username;
        var userRole = Context.Session.GetString("Role") ?? "Staff";
        var isOwner = userRole == "Admin";
        var roleTitle = isOwner ? "👑 Chủ Cửa Hàng" : "👤 Nhân Viên";
        var roleBadgeClass = isOwner ? "bg-warning text-dark fw-bold" : "bg-secondary text-white";
    }

    @if (string.IsNullOrEmpty(username))
    {
        <li class="nav-item">
            <a class="nav-link text-primary" asp-controller="Account" asp-action="Register">
                <i class="fa-solid fa-user-plus"></i> Đăng Ký
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary text-white btn-sm ms-2 shadow-sm" asp-controller="Account" asp-action="Login">
                <i class="fa-solid fa-right-to-bracket"></i> Đăng Nhập
            </a>
        </li>
    }
    else
    {
        var firstLetter = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1).ToUpper() : "U";

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar shadow-sm">@firstLetter</div>
                
                <div class="d-none d-lg-block">
                    <span class="fw-bold text-dark">@fullName</span>
                    <br>
                    <span class="badge @roleBadgeClass" style="font-size: 0.65rem;">@roleTitle</span>
                </div>
            </a>
            
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 animate slideIn" aria-labelledby="navbarDropdown">
                <li>
                    <div class="px-3 py-2 text-center border-bottom mb-2">
                        <div class="user-avatar mx-auto mb-2" style="width: 50px; height: 50px; font-size: 1.5rem;">
                            @firstLetter
                        </div>
                        <p class="mb-1 fw-bold">@fullName</p>
                        <span class="badge @roleBadgeClass mb-1">@roleTitle</span>
                        <div class="small text-muted">@@@username</div>
                    </div>
                </li>
                <li>
                     <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                        <i class="fa-solid fa-id-card me-2 text-primary"></i> Hồ sơ cá nhân
                     </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </li>
    }
</ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light mt-5">
        <div class="container text-center py-3">
            &copy; 2026 - Phần Mềm Quản Lý Cầm Đồ - <a asp-area="" asp-controller="Home" asp-action="Privacy">Bảo Mật</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function() {
            FetchUnreadCount();
            setInterval(FetchUnreadCount, 30000);
        });

        function FetchUnreadCount() {
            $.get('/api/NotificationsApi/unread', function(data) {
                if (data && data.unreadCount > 0) {
                    $('#notifBadge').text(data.unreadCount).show();
                } else {
                    $('#notifBadge').hide();
                }
            });
        }

        function LoadNotifications() {
            $.get('/api/NotificationsApi/unread', function(data) {
                let container = $('#notifList');
                if (!data || !data.items || data.items.length === 0) {
                    container.html('<div class="text-center py-4 text-muted small"><i class="fa-solid fa-bell-slash fs-4 d-block mb-1"></i> Chưa có thông báo mới</div>');
                    return;
                }

                let html = '';
                data.items.forEach(item => {
                    let bgClass = item.isRead ? 'bg-white opacity-75' : 'bg-light fw-bold';
                    let targetUrl = item.url || '/PawnContracts';
                    html += `
                        <div class="list-group-item list-group-item-action ${bgClass} p-3 border-bottom" style="cursor: pointer;" onclick="OnNotifClick(${item.id}, '${targetUrl}')">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-dark fw-bold">${item.title}</span>
                                <small class="text-muted ms-2" style="font-size: 0.7rem;">${item.createdDate}</small>
                            </div>
                            <p class="small text-secondary mb-1" style="font-weight: normal; font-size: 0.82rem;">${item.message}</p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary small" style="font-size: 0.7rem;"><i class="fa-solid fa-arrow-right me-1"></i> Xem chi tiết hợp đồng</span>
                                ${!item.isRead ? `<button class="btn btn-link btn-sm text-secondary p-0 small text-decoration-none" onclick="MarkSingleRead(${item.id}, event)">Đánh dấu đã đọc</button>` : ''}
                            </div>
                        </div>
                    `;
                });
                container.html(html);
            }).fail(function() {
                $('#notifList').html('<div class="text-center py-4 text-muted small"><i class="fa-solid fa-bell-slash fs-4 d-block mb-1 text-muted"></i> Chưa có thông báo mới</div>');
            });
        }

        function OnNotifClick(id, url) {
            $.post('/api/NotificationsApi/mark-as-read/' + id, function() {
                window.location.href = url || '/PawnContracts';
            });
        }

        function MarkSingleRead(id, event) {
            if (event) event.stopPropagation();
            $.post('/api/NotificationsApi/mark-as-read/' + id, function() {
                FetchUnreadCount();
                LoadNotifications();
            });
        }

        function MarkAllRead(event) {
            if (event) event.stopPropagation();
            $.post('/api/NotificationsApi/mark-all-read', function() {
                FetchUnreadCount();
                LoadNotifications();
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>