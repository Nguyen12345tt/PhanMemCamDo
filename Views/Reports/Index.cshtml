@model IEnumerable<PhanMemCamDo.Controllers.DanhMucBaoCaoItem>
@using System.Text.Json

@{
    ViewData["Title"] = "Báo Cáo & Thống Kê Doanh Thu";
    var range = ViewBag.Range as string ?? "this_month";
    var monthlyChartData = ViewBag.MonthlyInterestChart as List<PhanMemCamDo.Controllers.MonthlyRevenueItem> ?? new List<PhanMemCamDo.Controllers.MonthlyRevenueItem>();

    var catNames = Model.Select(x => x.TenLoai).ToList();
    var catAmounts = Model.Select(x => x.TongTien).ToList();

    var chartMonthLabels = monthlyChartData.Select(x => x.MonthLabel).ToList();
    var chartMonthRevenues = monthlyChartData.Select(x => x.TotalRevenue).ToList();
}

<div class="container py-4">
    <!-- Top Header & Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-warning me-2"></i> Báo Cáo Doanh Thu & Phân Bổ Vốn</h3>
                    <p class="text-white-50 mb-0">Theo dõi dòng tiền, lợi nhuận thu lãi và tỷ lệ an toàn vốn đầu tư tiệm cầm đồ.</p>
                </div>
                <div>
                    <a asp-action="Index" asp-route-range="today" class="btn btn-sm @(range == "today" ? "btn-warning text-dark fw-bold" : "btn-outline-light")">Hôm Nay</a>
                    <a asp-action="Index" asp-route-range="this_month" class="btn btn-sm @(range == "this_month" ? "btn-warning text-dark fw-bold" : "btn-outline-light")">Tháng Này</a>
                    <a asp-action="Index" asp-route-range="last_month" class="btn btn-sm @(range == "last_month" ? "btn-warning text-dark fw-bold" : "btn-outline-light")">Tháng Trước</a>
                    <a asp-action="Index" asp-route-range="this_year" class="btn btn-sm @(range == "this_year" ? "btn-warning text-dark fw-bold" : "btn-outline-light")">Năm Nay</a>
                </div>
            </div>

            <!-- Bộ lọc từ ngày - đến ngày -->
            <form asp-action="Index" method="get" class="row g-2 align-items-end pt-2 border-top border-secondary">
                <div class="col-md-4 col-lg-3">
                    <label class="form-label small text-white-50 mb-1">Từ ngày:</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm bg-dark text-white border-secondary" />
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label small text-white-50 mb-1">Đến ngày:</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm bg-dark text-white border-secondary" />
                </div>
                <div class="col-md-4 col-lg-2">
                    <button type="submit" class="btn btn-warning btn-sm w-100 fw-bold">
                        <i class="fa-solid fa-filter me-1"></i> Lọc Báo Cáo
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 4 Thẻ chỉ số tổng quan (Stat Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center p-3 me-3" style="width: 54px; height: 54px;">
                        <i class="fa-solid fa-vault fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-white-50 fw-bold">VỐN NỢ GỐC ĐANG CẦM</div>
                        <h4 class="fw-bold mb-0">@string.Format("{0:N0}", ViewBag.TongVonDangChoVay) đ</h4>
                        <small class="text-white-50">@ViewBag.CountActive hợp đồng đang nợ</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center p-3 me-3" style="width: 54px; height: 54px;">
                        <i class="fa-solid fa-hand-holding-dollar fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-white-50 fw-bold">LỢI NHUẬN LÃI THU VỀ</div>
                        <h4 class="fw-bold mb-0">@string.Format("{0:N0}", ViewBag.TongLaiDaThu) đ</h4>
                        <small class="text-white-50">Thu lãi trong kỳ chọn</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white text-info d-flex align-items-center justify-content-center p-3 me-3" style="width: 54px; height: 54px;">
                        <i class="fa-solid fa-arrow-down-left-and-arrow-up-right-to-center fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-white-50 fw-bold">GỐC THU HỒI & CHUỘC</div>
                        <h4 class="fw-bold mb-0">@string.Format("{0:N0}", (decimal)ViewBag.TongGocDaThu + (decimal)ViewBag.TongThuChuocDo) đ</h4>
                        <small class="text-white-50">Trả bớt gốc + Chuộc đồ</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 bg-danger text-white h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center p-3 me-3" style="width: 54px; height: 54px;">
                        <i class="fa-solid fa-gavel fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-white-50 fw-bold">THU BÁN THANH LÝ</div>
                        <h4 class="fw-bold mb-0">@string.Format("{0:N0}", ViewBag.TongThuThanhLy) đ</h4>
                        <small class="text-white-50">Thu hồi vốn bán tài sản bùng</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ trực quan (Charts Section) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ cột: Lợi nhuận tiền lãi 6 tháng -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-light rounded-top-4">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-chart-column text-success me-2"></i> Lợi Nhuận Tiền Lãi Thu Về (6 Tháng Gần Nhất)
                    </h6>
                </div>
                <div class="card-body p-3">
                    <canvas id="revenueBarChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ tròn: Phân bổ vốn theo loại tài sản -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-light rounded-top-4">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-chart-pie text-primary me-2"></i> Tỷ Lệ Phân Bổ Vốn Theo Tài Sản
                    </h6>
                </div>
                <div class="card-body p-3 d-flex align-items-center justify-content-center">
                    @if (Model.Any())
                    {
                        <canvas id="assetPieChart" style="max-height: 280px;"></canvas>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-solid fa-box-open fs-1 text-black-50 mb-2"></i>
                            <div>Chưa có dữ liệu phân bổ vốn</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng thông tin chi tiết -->
    <div class="row g-4">
        <!-- Bảng Phân Bổ Vốn Chi Tiết -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-light rounded-top-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list text-primary me-2"></i> Phân Bổ Vốn Theo Loại Tài Sản Thế Chấp</h6>
                    <span class="badge bg-light text-dark border">Tổng vốn: @string.Format("{0:N0}", ViewBag.TongVonDangChoVay) đ</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-uppercase small text-muted">
                                <tr>
                                    <th class="ps-4">Loại Tài Sản</th>
                                    <th class="text-center">Số Lượng HĐ</th>
                                    <th class="text-end">Tổng Tiền Cầm (VNĐ)</th>
                                    <th class="pe-4 text-end">Tỷ Trọng Vốn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">
                                                <i class="fa-solid fa-tag me-2 text-muted"></i>@item.TenLoai
                                            </td>
                                            <td class="text-center fw-bold">@item.SoLuong</td>
                                            <td class="text-end fw-bold text-danger">@string.Format("{0:N0}", item.TongTien) đ</td>
                                            <td class="pe-4 text-end">
                                                <div class="d-flex align-items-center justify-content-end gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @item.TiLeVon%;"></div>
                                                    </div>
                                                    <span class="fw-bold text-dark small">@item.TiLeVon%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Hiện chưa có hợp đồng nào đang chạy.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Trạng Thái Hợp Đồng -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-light rounded-top-4">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-pie-chart text-info me-2"></i> Trạng Thái Tất Cả Hợp Đồng</h6>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <span><i class="fa-solid fa-circle text-success me-2"></i> Hợp đồng đang chạy</span>
                            <span class="badge bg-success rounded-pill px-3 fs-6">@ViewBag.CountActive</span>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <span><i class="fa-solid fa-circle text-danger me-2"></i> Hợp đồng quá hạn</span>
                            <span class="badge bg-danger rounded-pill px-3 fs-6">@ViewBag.CountOverdue</span>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <span><i class="fa-solid fa-circle text-primary me-2"></i> Đã chuộc / tất toán</span>
                            <span class="badge bg-primary rounded-pill px-3 fs-6">@ViewBag.CountRedeemed</span>
                        </div>
                        <div class="list-group-item border-0 d-flex justify-content-between align-items-center px-0 py-2">
                            <span><i class="fa-solid fa-circle text-dark me-2"></i> Đã thanh lý tài sản</span>
                            <span class="badge bg-dark rounded-pill px-3 fs-6">@ViewBag.CountLiquidated</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Vẽ Biểu Đồ Cột: Lợi Nhuận Tiền Lãi 6 Tháng
        var ctxBar = document.getElementById('revenueBarChart');
        if (ctxBar) {
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(chartMonthLabels)),
                    datasets: [{
                        label: 'Lợi Nhuận Tiền Lãi (VNĐ)',
                        data: @Html.Raw(JsonSerializer.Serialize(chartMonthRevenues)),
                        backgroundColor: 'rgba(34, 197, 94, 0.75)',
                        borderColor: 'rgba(34, 197, 94, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return value.toLocaleString('vi-VN') + ' đ'; }
                            }
                        }
                    }
                }
            });
        }

        // 2. Vẽ Biểu Đồ Tròn: Tỷ Lệ Phân Bổ Vốn
        var ctxPie = document.getElementById('assetPieChart');
        if (ctxPie) {
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(JsonSerializer.Serialize(catNames)),
                    datasets: [{
                        data: @Html.Raw(JsonSerializer.Serialize(catAmounts)),
                        backgroundColor: [
                            '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#64748b'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }
    </script>
}